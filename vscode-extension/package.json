{
  "name": "nuinuicad",
  "displayName": "nuinuiCAD",
  "description": "%extension.description%",
  "version": "0.0.0",
  "publisher": "yosomi",
  "private": true,
  "engines": {
    "vscode": ">=1.90.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[nui]": {
        "editor.wordBasedSuggestions": "off"
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nuinuiCAD.explorer",
          "title": "%views.explorerContainer%",
          "icon": "media/spline.svg"
        }
      ]
    },
    "views": {
      "nuinuiCAD.explorer": [
        {
          "id": "nuinuiCAD.elements",
          "name": "%views.elements%"
        },
        {
          "id": "nuinuiCAD.explorerMock",
          "name": "%views.explorerMock%",
          "type": "webview"
        },
        {
          "id": "nuinuiCAD.modulePreviewParameters",
          "name": "%views.modulePreviewParameters%",
          "type": "webview"
        }
      ]
    },
    "submenus": [
      {
        "id": "nuinuiCAD.convertPoint",
        "label": "%submenu.convert%"
      },
      {
        "id": "nuinuiCAD.webview.canvasDisplay",
        "label": "%submenu.webview.display%"
      },
      {
        "id": "nuinuiCAD.webview.modulePreviewDisplay",
        "label": "%submenu.webview.display%"
      },
      {
        "id": "nuinuiCAD.webview.convertPoint",
        "label": "%submenu.webview.convertPoint%"
      },
      {
        "id": "nuinuiCAD.webview.bake",
        "label": "%submenu.webview.bake%"
      }
    ],
    "keybindings": [
      {
        "command": "nuinuiCAD.stepSourceValueForward.keybinding",
        "key": "ctrl+shift+.",
        "mac": "shift+cmd+.",
        "when": "editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && !editorReadonly"
      },
      {
        "command": "nuinuiCAD.stepSourceValueBackward.keybinding",
        "key": "ctrl+shift+,",
        "mac": "shift+cmd+,",
        "when": "editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && !editorReadonly"
      },
      {
        "command": "nuinuiCAD.modulePreviewValueStepForward.keybinding",
        "key": "ctrl+shift+.",
        "mac": "shift+cmd+.",
        "when": "focusedView == 'nuinuiCAD.modulePreviewParameters' && nuinuiCAD.modulePreviewValueInputFocus"
      },
      {
        "command": "nuinuiCAD.modulePreviewValueStepBackward.keybinding",
        "key": "ctrl+shift+,",
        "mac": "shift+cmd+,",
        "when": "focusedView == 'nuinuiCAD.modulePreviewParameters' && nuinuiCAD.modulePreviewValueInputFocus"
      },
      {
        "command": "nuinuiCAD.canvasUndo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' || activeWebviewPanelId == 'nuinuiCAD.modulePreview' || (editorTextFocus && nuinuiCAD.canvasHistoryHandoff)"
      },
      {
        "command": "nuinuiCAD.canvasRedo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' || activeWebviewPanelId == 'nuinuiCAD.modulePreview' || (editorTextFocus && nuinuiCAD.canvasHistoryHandoff)"
      },
      {
        "command": "nuinuiCAD.outputPreviewUndo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeWebviewPanelId == 'nuinuiCAD.outputPreview'"
      },
      {
        "command": "nuinuiCAD.outputPreviewRedo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "activeWebviewPanelId == 'nuinuiCAD.outputPreview'"
      },
      {
        "command": "nuinuiCAD.createGeometry",
        "key": "ctrl+shift+alt+n",
        "mac": "shift+alt+n",
        "when": "editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && !editorReadonly"
      },
      {
        "command": "nuinuiCAD.createFreePointAtPointer",
        "key": "ctrl+shift+alt+n",
        "mac": "shift+alt+n",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' && !inputFocus"
      },
      {
        "command": "nuinuiCAD.revealInCanvas",
        "key": "ctrl+shift+alt+c",
        "mac": "shift+alt+c",
        "when": "editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.revealInCanvasSourceTarget"
      },
      {
        "command": "nuinuiCAD.openCanvas",
        "key": "ctrl+shift+alt+c",
        "mac": "shift+alt+c",
        "when": "(editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && !nuinuiCAD.revealInCanvasSourceTarget) || (activeWebviewPanelId == 'nuinuiCAD.outputPreview' && !inputFocus)"
      },
      {
        "command": "nuinuiCAD.revealInOutputPreview",
        "key": "ctrl+shift+alt+o",
        "mac": "shift+alt+o",
        "when": "editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.revealInOutputPreviewSourceTarget"
      },
      {
        "command": "nuinuiCAD.openOutputPreview",
        "key": "ctrl+shift+alt+o",
        "mac": "shift+alt+o",
        "when": "(editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && !nuinuiCAD.revealInOutputPreviewSourceTarget) || (activeWebviewPanelId == 'nuinuiCAD.canvas' && !inputFocus)"
      },
      {
        "command": "nuinuiCAD.openModulePreview",
        "key": "ctrl+shift+alt+m",
        "mac": "shift+alt+m",
        "when": "editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.modulePreviewSourceTarget"
      },
      {
        "command": "nuinuiCAD.inlineModuleInstance",
        "key": "ctrl+shift+alt+l",
        "mac": "shift+alt+l",
        "when": "(editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.inlineModuleSourceTarget) || (activeWebviewPanelId == 'nuinuiCAD.canvas' && nuinuiCAD.inlineModuleCanvasTarget && !inputFocus)"
      },
      {
        "command": "nuinuiCAD.extractModule",
        "key": "ctrl+shift+alt+x",
        "mac": "shift+alt+x",
        "when": "(editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.extractModuleSourceTarget) || (activeWebviewPanelId == 'nuinuiCAD.canvas' && nuinuiCAD.extractModuleCanvasTarget && !inputFocus)"
      },
      {
        "command": "nuinuiCAD.selectInstance",
        "key": "ctrl+shift+alt+i",
        "mac": "shift+alt+i",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' && nuinuiCAD.canvasCanSelectInstance && !inputFocus"
      },
      {
        "command": "nuinuiCAD.selectParentGroup",
        "key": "ctrl+shift+alt+u",
        "mac": "shift+alt+u",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' && nuinuiCAD.canvasHasSelection && !inputFocus"
      },
      {
        "command": "nuinuiCAD.clearCanvasSelection",
        "key": "ctrl+shift+alt+d",
        "mac": "shift+alt+d",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' && nuinuiCAD.canvasHasSelection && !inputFocus"
      },
      {
        "command": "nuinuiCAD.modulePreview.clearSelection",
        "key": "ctrl+shift+alt+d",
        "mac": "shift+alt+d",
        "when": "activeWebviewPanelId == 'nuinuiCAD.modulePreview' && nuinuiCAD.canvasHasSelection && !inputFocus"
      },
      {
        "command": "nuinuiCAD.clearOutputPreviewFocus",
        "key": "ctrl+shift+alt+d",
        "mac": "shift+alt+d",
        "when": "activeWebviewPanelId == 'nuinuiCAD.outputPreview' && !inputFocus"
      },
      {
        "command": "nuinuiCAD.fitDrawing",
        "key": "ctrl+shift+alt+f",
        "mac": "shift+alt+f",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' && !inputFocus"
      },
      {
        "command": "nuinuiCAD.modulePreview.fitDrawing",
        "key": "ctrl+shift+alt+f",
        "mac": "shift+alt+f",
        "when": "activeWebviewPanelId == 'nuinuiCAD.modulePreview' && !inputFocus"
      },
      {
        "command": "nuinuiCAD.fitOutputPreview",
        "key": "ctrl+shift+alt+f",
        "mac": "shift+alt+f",
        "when": "activeWebviewPanelId == 'nuinuiCAD.outputPreview' && !inputFocus"
      },
      {
        "command": "nuinuiCAD.resetCanvasView",
        "key": "ctrl+shift+alt+r",
        "mac": "shift+alt+r",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' && !inputFocus"
      },
      {
        "command": "nuinuiCAD.modulePreview.resetView",
        "key": "ctrl+shift+alt+r",
        "mac": "shift+alt+r",
        "when": "activeWebviewPanelId == 'nuinuiCAD.modulePreview' && !inputFocus"
      },
      {
        "command": "nuinuiCAD.resetOutputPreviewView",
        "key": "ctrl+shift+alt+r",
        "mac": "shift+alt+r",
        "when": "activeWebviewPanelId == 'nuinuiCAD.outputPreview' && !inputFocus"
      },
      {
        "command": "nuinuiCAD.editCanvasRibbon",
        "key": "ctrl+shift+alt+e",
        "mac": "shift+alt+e",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' && !inputFocus"
      },
      {
        "command": "nuinuiCAD.exportCurrentOutput",
        "key": "ctrl+shift+alt+e",
        "mac": "shift+alt+e",
        "when": "activeWebviewPanelId == 'nuinuiCAD.outputPreview' && !inputFocus"
      },
      {
        "command": "nuinuiCAD.convertPointToXYOffset",
        "key": "ctrl+shift+alt+y",
        "mac": "shift+alt+y",
        "when": "(editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.coordinatePointConversionSourceTarget) || (activeWebviewPanelId == 'nuinuiCAD.canvas' && nuinuiCAD.canvasHasCoordinatePointConversionTarget && !inputFocus)"
      },
      {
        "command": "nuinuiCAD.convertPointToAngleDistanceOffset",
        "key": "ctrl+shift+alt+p",
        "mac": "shift+alt+p",
        "when": "(editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.coordinatePointConversionSourceTarget) || (activeWebviewPanelId == 'nuinuiCAD.canvas' && nuinuiCAD.canvasHasCoordinatePointConversionTarget && !inputFocus)"
      },
      {
        "command": "nuinuiCAD.replaceGeometryReferences",
        "key": "ctrl+shift+alt+t",
        "mac": "shift+alt+t",
        "when": "editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && !editorReadonly && nuinuiCAD.geometryReferenceRetargetSourceTarget"
      },
      {
        "command": "nuinuiCAD.bakeCurrentShape",
        "key": "ctrl+shift+alt+s",
        "mac": "shift+alt+s",
        "when": "(editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.bakeSourceTarget) || ((activeWebviewPanelId == 'nuinuiCAD.canvas' || activeWebviewPanelId == 'nuinuiCAD.modulePreview') && nuinuiCAD.canvasHasSelection && !inputFocus)"
      },
      {
        "command": "nuinuiCAD.bakeBaseShape",
        "key": "ctrl+shift+alt+b",
        "mac": "shift+alt+b",
        "when": "(editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.bakeSourceTarget) || ((activeWebviewPanelId == 'nuinuiCAD.canvas' || activeWebviewPanelId == 'nuinuiCAD.modulePreview') && nuinuiCAD.canvasHasSelection && !inputFocus)"
      },
      {
        "command": "nuinuiCAD.pickReferenceFromCanvas",
        "key": "alt+enter",
        "mac": "alt+enter",
        "when": "editorTextFocus && editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.referencePickSourceTarget"
      },
      {
        "command": "nuinuiCAD.goToSourceDefinition",
        "key": "f12",
        "mac": "f12",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' && nuinuiCAD.canvasHasSelection && !inputFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nuinuiCAD.openCanvas",
          "when": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui) || activeWebviewPanelId == 'nuinuiCAD.outputPreview'"
        },
        {
          "command": "nuinuiCAD.openOutputPreview",
          "when": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui) || activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.openModulePreview",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.editCanvasRibbon",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.goToSourceDefinition",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.revealInCanvas",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.revealInOutputPreview",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.pickReferenceFromCanvas",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.inlineModuleInstance",
          "when": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui) || activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.extractModule",
          "when": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui) || activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.convertPointToXYOffset",
          "when": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui) || activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.convertPointToAngleDistanceOffset",
          "when": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui) || activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.replaceGeometryReferences",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.stepSourceValueForward",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.stepSourceValueBackward",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.clearCanvasSelection",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.selectParentGroup",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.selectInstance",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.resetCanvasView",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.fitDrawing",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.resetOutputPreviewView",
          "when": "activeWebviewPanelId == 'nuinuiCAD.outputPreview'"
        },
        {
          "command": "nuinuiCAD.fitOutputPreview",
          "when": "activeWebviewPanelId == 'nuinuiCAD.outputPreview'"
        },
        {
          "command": "nuinuiCAD.clearOutputPreviewFocus",
          "when": "activeWebviewPanelId == 'nuinuiCAD.outputPreview'"
        },
        {
          "command": "nuinuiCAD.exportCurrentOutput",
          "when": "activeWebviewPanelId == 'nuinuiCAD.outputPreview'"
        },
        {
          "command": "nuinuiCAD.toggleCanvasPointNames",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.toggleCanvasGeometryNames",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.toggleCanvasElementNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.toggleCanvasPoints",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.bakeCurrentShape",
          "when": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui) || activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.bakeBaseShape",
          "when": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui) || activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.canvasUndo",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.canvasRedo",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.outputPreviewUndo",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.outputPreviewRedo",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.modulePreview.clearSelection",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.modulePreview.resetView",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.modulePreview.fitDrawing",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.modulePreview.togglePointNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.modulePreview.toggleGeometryNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.modulePreview.togglePoints",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.createGeometry",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.createFreePointAtPointer",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.webview.showCanvasPointNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.webview.hideCanvasPointNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.webview.showCanvasGeometryNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.webview.hideCanvasGeometryNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.webview.showCanvasPoints",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.webview.hideCanvasPoints",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.webview.modulePreview.showPointNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.webview.modulePreview.hidePointNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.webview.modulePreview.showGeometryNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.webview.modulePreview.hideGeometryNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.webview.modulePreview.showPoints",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.webview.modulePreview.hidePoints",
          "when": "false"
        }
      ],
      "nuinuiCAD.convertPoint": [
        {
          "command": "nuinuiCAD.convertPointToXYOffset",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.coordinatePointConversionSourceTarget"
        },
        {
          "command": "nuinuiCAD.convertPointToAngleDistanceOffset",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.coordinatePointConversionSourceTarget"
        },
        {
          "command": "nuinuiCAD.convertPointToXYOffset",
          "when": "view == nuinuiCAD.elements && viewItem == 'nuinuiCAD.coordinatePointConversionTarget'"
        },
        {
          "command": "nuinuiCAD.convertPointToAngleDistanceOffset",
          "when": "view == nuinuiCAD.elements && viewItem == 'nuinuiCAD.coordinatePointConversionTarget'"
        }
      ],
      "view/title": [
        {
          "command": "nuinuiCAD.openCanvas",
          "when": "view == nuinuiCAD.elements",
          "group": "navigation@1"
        },
        {
          "command": "nuinuiCAD.openOutputPreview",
          "when": "view == nuinuiCAD.elements",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "submenu": "nuinuiCAD.convertPoint",
          "when": "view == nuinuiCAD.elements && viewItem == 'nuinuiCAD.coordinatePointConversionTarget'",
          "group": "1_modification@1"
        }
      ],
      "webview/context": [
        {
          "command": "nuinuiCAD.createFreePointAtPointer",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'blank'",
          "group": "1_create@0"
        },
        {
          "command": "nuinuiCAD.fitDrawing",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'blank'",
          "group": "2_view@1"
        },
        {
          "command": "nuinuiCAD.resetCanvasView",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'blank'",
          "group": "2_view@2"
        },
        {
          "submenu": "nuinuiCAD.webview.canvasDisplay",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'blank'",
          "group": "2_view@3"
        },
        {
          "command": "nuinuiCAD.editCanvasRibbon",
          "when": "(webviewId == 'nuinuiCAD.canvas' || webviewId == 'nuinuiCAD.modulePreview') && (webviewSection == 'blank' || webviewSection == 'ribbon')",
          "group": "3_edit@1"
        },
        {
          "command": "nuinuiCAD.clearCanvasSelection",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'blank' && nuinuiCAD.canvasHasSelection",
          "group": "4_selection@1"
        },
        {
          "submenu": "nuinuiCAD.webview.convertPoint",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'element' && nuinuiCAD.canvasHasCoordinatePointConversionTarget",
          "group": "1_modification@1"
        },
        {
          "command": "nuinuiCAD.selectParentGroup",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'element' && nuinuiCAD.canvasHasSelection",
          "group": "1_modification@2"
        },
        {
          "command": "nuinuiCAD.selectInstance",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'element' && nuinuiCAD.canvasCanSelectInstance",
          "group": "1_modification@3"
        },
        {
          "command": "nuinuiCAD.goToSourceDefinition",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'element' && nuinuiCAD.canvasHasSelection",
          "group": "1_modification@4"
        },
        {
          "command": "nuinuiCAD.inlineModuleInstance",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'element' && nuinuiCAD.inlineModuleCanvasTarget",
          "group": "1_modification@7"
        },
        {
          "command": "nuinuiCAD.extractModule",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'element' && nuinuiCAD.extractModuleCanvasTarget",
          "group": "1_modification@8"
        },
        {
          "submenu": "nuinuiCAD.webview.bake",
          "when": "(webviewId == 'nuinuiCAD.canvas' || webviewId == 'nuinuiCAD.modulePreview') && webviewSection == 'element' && nuinuiCAD.canvasHasSelection",
          "group": "1_modification@9"
        },
        {
          "command": "nuinuiCAD.resetOutputPreviewView",
          "when": "webviewId == 'nuinuiCAD.outputPreview' && webviewSection == 'blank'",
          "group": "2_view@1"
        },
        {
          "command": "nuinuiCAD.fitOutputPreview",
          "when": "webviewId == 'nuinuiCAD.outputPreview' && webviewSection == 'blank'",
