{
  "name": "nuinuicad",
  "displayName": "nuinuiCAD",
  "description": "2D parametric CAD for sewing pattern drafting in VS Code.",
  "version": "0.0.0",
  "publisher": "yosomi",
  "private": true,
  "engines": {
    "vscode": ">=1.90.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[nui]": {
        "editor.wordBasedSuggestions": "off"
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nuinuiCAD.explorer",
          "title": "nuinuiCAD Explorer",
          "icon": "media/spline.svg"
        }
      ]
    },
    "views": {
      "nuinuiCAD.explorer": [
        {
          "id": "nuinuiCAD.elements",
          "name": "Elements"
        },
        {
          "id": "nuinuiCAD.explorerMock",
          "name": "Explorer Mock",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nuinuiCAD.canvasUndo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' || (editorTextFocus && nuinuiCAD.canvasHistoryHandoff)"
      },
      {
        "command": "nuinuiCAD.canvasRedo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' || (editorTextFocus && nuinuiCAD.canvasHistoryHandoff)"
      },
      {
        "command": "nuinuiCAD.outputPreviewUndo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeWebviewPanelId == 'nuinuiCAD.outputPreview'"
      },
      {
        "command": "nuinuiCAD.outputPreviewRedo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "activeWebviewPanelId == 'nuinuiCAD.outputPreview'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nuinuiCAD.openCanvas",
          "when": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui) || activeWebviewPanelId == 'nuinuiCAD.outputPreview'"
        },
        {
          "command": "nuinuiCAD.openOutputPreview",
          "when": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui) || activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.openModulePreview",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.editCanvasRibbon",
          "when": "true"
        },
        {
          "command": "nuinuiCAD.goToSourceDefinition",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.revealInCanvas",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.pickReferenceFromCanvas",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.clearCanvasSelection",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.resetCanvasView",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.fitDrawing",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.fitOutputPreview",
          "when": "activeWebviewPanelId == 'nuinuiCAD.outputPreview'"
        },
        {
          "command": "nuinuiCAD.toggleCanvasPointNames",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.toggleCanvasGeometryNames",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.toggleCanvasElementNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.toggleCanvasPoints",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.bakeCurrentShape",
          "when": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui) || activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.bakeBaseShape",
          "when": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui) || activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.canvasUndo",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.canvasRedo",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.outputPreviewUndo",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.outputPreviewRedo",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.modulePreview.clearSelection",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.modulePreview.resetView",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.modulePreview.fitDrawing",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.modulePreview.togglePointNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.modulePreview.toggleGeometryNames",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.modulePreview.togglePoints",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "nuinuiCAD.openCanvas",
          "when": "view == nuinuiCAD.elements",
          "group": "navigation@1"
        },
        {
          "command": "nuinuiCAD.openOutputPreview",
          "when": "view == nuinuiCAD.elements",
          "group": "navigation@2"
        }
      ],
      "webview/context": [
        {
          "command": "nuinuiCAD.fitDrawing",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'blank'"
        },
        {
          "command": "nuinuiCAD.resetCanvasView",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'blank'"
        },
        {
          "command": "nuinuiCAD.toggleCanvasPointNames",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'blank'"
        },
        {
          "command": "nuinuiCAD.toggleCanvasGeometryNames",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'blank'"
        },
        {
          "command": "nuinuiCAD.toggleCanvasPoints",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'blank'"
        },
        {
          "command": "nuinuiCAD.editCanvasRibbon",
          "when": "(webviewId == 'nuinuiCAD.canvas' || webviewId == 'nuinuiCAD.modulePreview') && (webviewSection == 'blank' || webviewSection == 'ribbon')"
        },
        {
          "command": "nuinuiCAD.clearCanvasSelection",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'blank' && nuinuiCAD.canvasHasSelection"
        },
        {
          "command": "nuinuiCAD.goToSourceDefinition",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'element' && nuinuiCAD.canvasHasSelection"
        },
        {
          "command": "nuinuiCAD.bakeCurrentShape",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'element' && nuinuiCAD.canvasHasSelection"
        },
        {
          "command": "nuinuiCAD.bakeBaseShape",
          "when": "webviewId == 'nuinuiCAD.canvas' && webviewSection == 'element' && nuinuiCAD.canvasHasSelection"
        },
        {
          "command": "nuinuiCAD.modulePreview.fitDrawing",
          "when": "webviewId == 'nuinuiCAD.modulePreview' && webviewSection == 'blank'"
        },
        {
          "command": "nuinuiCAD.modulePreview.resetView",
          "when": "webviewId == 'nuinuiCAD.modulePreview' && webviewSection == 'blank'"
        },
        {
          "command": "nuinuiCAD.modulePreview.togglePointNames",
          "when": "webviewId == 'nuinuiCAD.modulePreview' && webviewSection == 'blank'"
        },
        {
          "command": "nuinuiCAD.modulePreview.toggleGeometryNames",
          "when": "webviewId == 'nuinuiCAD.modulePreview' && webviewSection == 'blank'"
        },
        {
          "command": "nuinuiCAD.modulePreview.togglePoints",
          "when": "webviewId == 'nuinuiCAD.modulePreview' && webviewSection == 'blank'"
        },
        {
          "command": "nuinuiCAD.modulePreview.clearSelection",
          "when": "webviewId == 'nuinuiCAD.modulePreview' && webviewSection == 'blank' && nuinuiCAD.canvasHasSelection"
        }
      ],
      "editor/context": [
        {
          "command": "nuinuiCAD.revealInCanvas",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.openModulePreview",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.modulePreviewSourceTarget"
        },
        {
          "command": "nuinuiCAD.pickReferenceFromCanvas",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.referencePickSourceTarget"
        }
      ]
    },
    "commands": [
      {
        "command": "nuinuiCAD.openCanvas",
        "title": "nuinuiCAD: Open Canvas",
        "shortTitle": "Open Canvas",
        "icon": {
          "light": "media/spline.svg",
          "dark": "media/spline.svg"
        }
      },
      {
        "command": "nuinuiCAD.openOutputPreview",
        "title": "nuinuiCAD: Open Output Preview",
        "shortTitle": "Open Output Preview",
        "icon": {
          "light": "media/printer.svg",
          "dark": "media/printer.svg"
        }
      },
      {
        "command": "nuinuiCAD.openModulePreview",
        "title": "nuinuiCAD: Open Module Preview",
        "shortTitle": "Open Module Preview",
        "enablement": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.modulePreviewSourceTarget"
      },
      {
        "command": "nuinuiCAD.goToSourceDefinition",
        "title": "nuinuiCAD: Go to Source Definition",
        "enablement": "activeWebviewPanelId == 'nuinuiCAD.canvas' && nuinuiCAD.canvasHasSelection"
      },
      {
        "command": "nuinuiCAD.revealInCanvas",
        "title": "nuinuiCAD: Reveal in Canvas",
        "enablement": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.revealInCanvasSourceTarget"
      },
      {
        "command": "nuinuiCAD.pickReferenceFromCanvas",
        "title": "nuinuiCAD: Pick Reference from Canvas",
        "enablement": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.referencePickSourceTarget"
      },
      {
        "command": "nuinuiCAD.canvasUndo",
        "title": "nuinuiCAD: Undo Canvas Transition"
      },
      {
        "command": "nuinuiCAD.canvasRedo",
        "title": "nuinuiCAD: Redo Canvas Transition"
      },
      {
        "command": "nuinuiCAD.outputPreviewUndo",
        "title": "nuinuiCAD: Undo Output Preview Source Edit"
      },
      {
        "command": "nuinuiCAD.outputPreviewRedo",
        "title": "nuinuiCAD: Redo Output Preview Source Edit"
      },
      {
        "command": "nuinuiCAD.clearCanvasSelection",
        "title": "nuinuiCAD: Clear Canvas Selection",
        "enablement": "activeWebviewPanelId == 'nuinuiCAD.canvas' && nuinuiCAD.canvasHasSelection"
      },
      {
        "command": "nuinuiCAD.resetCanvasView",
        "title": "nuinuiCAD: Reset Canvas View"
      },
      {
        "command": "nuinuiCAD.fitDrawing",
        "title": "nuinuiCAD: Fit Drawing"
      },
      {
        "command": "nuinuiCAD.fitOutputPreview",
        "title": "nuinuiCAD: Fit Output Preview"
      },
      {
        "command": "nuinuiCAD.toggleCanvasPointNames",
        "title": "nuinuiCAD: Toggle Point Names"
      },
      {
        "command": "nuinuiCAD.toggleCanvasGeometryNames",
        "title": "nuinuiCAD: Toggle Geometry Names"
      },
      {
        "command": "nuinuiCAD.toggleCanvasElementNames",
        "title": "nuinuiCAD: Toggle Canvas Element Names (Legacy)"
      },
      {
        "command": "nuinuiCAD.toggleCanvasPoints",
        "title": "nuinuiCAD: Toggle Canvas Points"
      },
      {
        "command": "nuinuiCAD.bakeCurrentShape",
        "title": "nuinuiCAD: Bake Current Shape",
        "enablement": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.bakeSourceTarget) || (activeWebviewPanelId == 'nuinuiCAD.canvas' && nuinuiCAD.canvasHasSelection)"
      },
      {
        "command": "nuinuiCAD.bakeBaseShape",
        "title": "nuinuiCAD: Bake Base Shape",
        "enablement": "(editorLangId == nui && resourceScheme == file && resourceExtname == .nui && nuinuiCAD.bakeSourceTarget) || (activeWebviewPanelId == 'nuinuiCAD.canvas' && nuinuiCAD.canvasHasSelection)"
      },
      {
        "command": "nuinuiCAD.editCanvasRibbon",
        "title": "nuinuiCAD: Edit Canvas Ribbon"
      },
      {
        "command": "nuinuiCAD.modulePreview.clearSelection",
        "title": "nuinuiCAD: Clear Module Preview Selection"
      },
      {
        "command": "nuinuiCAD.modulePreview.resetView",
        "title": "nuinuiCAD: Reset Module Preview View"
      },
      {
        "command": "nuinuiCAD.modulePreview.fitDrawing",
        "title": "nuinuiCAD: Fit Module Preview Drawing"
      },
      {
        "command": "nuinuiCAD.modulePreview.togglePointNames",
        "title": "nuinuiCAD: Toggle Module Preview Point Names"
      },
      {
        "command": "nuinuiCAD.modulePreview.toggleGeometryNames",
        "title": "nuinuiCAD: Toggle Module Preview Geometry Names"
      },
      {
        "command": "nuinuiCAD.modulePreview.togglePoints",
        "title": "nuinuiCAD: Toggle Module Preview Points"
      }
    ],
    "configuration": {
      "title": "nuinuiCAD",
      "properties": {
        "nuinuiCAD.developer.mcpObservation.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Enable the private developer-only loopback observation bridge used by nuinuiCAD MCP/E2E tooling. Reload the Extension Host after changing this setting."
        },
        "nuinuiCAD.bake.emitSkippedComments": {
          "type": "boolean",
          "default": true,
          "description": "Bakeできない対象の位置に理由コメントを挿入します。"
        },
        "nuinuiCAD.bake.includeHiddenGeometry": {
          "type": "boolean",
          "default": false,
          "description": "Bake対象にhidden geometryを含めます。"
        },
        "nuinuiCAD.bake.includeDisabledGeometry": {
          "type": "boolean",
          "default": false,
          "description": "Bake対象にdisabled geometryを含めます。"
        },
        "nuinuiCAD.canvasRibbon.ribbons": {
          "type": "array",
          "scope": "application",
          "description": "Canvas Ribbons shown in the nuinuiCAD VS Code Canvas.",
          "default": [
            {
              "id": "canvas-ribbon",
              "label": "Canvas Ribbon",
              "x": null,
              "y": 12,
              "orientation": "horizontal",
              "items": [
                {
                  "id": "editCanvasRibbon",
                  "type": "command",
                  "commandId": "editCanvasRibbon",
                  "icon": "settings-2",
                  "showLabel": false
                }
              ]
            }
          ],
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["id", "label", "x", "y", "orientation", "items"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "label": { "type": "string" },
                  "x": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
                  "y": { "type": "number" },
                  "orientation": { "enum": ["horizontal", "vertical"] },
                  "items": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "required": ["id", "type", "commandId", "icon", "showLabel"],
                          "properties": {
                            "id": { "type": "string", "minLength": 1 },
                            "type": { "const": "command" },
                            "commandId": { "type": "string", "minLength": 1 },
                            "icon": { "type": "string", "minLength": 1 },
                            "showLabel": { "type": "boolean" }
                          }
                        },
                        {
                          "type": "object",
                          "required": ["id", "type", "valueId"],
                          "properties": {
                            "id": { "type": "string", "minLength": 1 },
                            "type": { "const": "value" },
                            "valueId": { "const": "canvasZoom" }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "languages": [
      {
        "id": "nui",
        "aliases": ["nuinuiCAD", "nui"],
        "extensions": [".nui"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nui",
        "scopeName": "source.nui",
        "path": "./syntaxes/nui.tmLanguage.json",
        "tokenTypes": {
          "meta.interpolation.nui": "other"
        }
      }
    ]
  },
  "scripts": {}
}
