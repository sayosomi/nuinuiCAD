{
  "name": "nuinuicad",
  "displayName": "nuinuiCAD",
  "description": "2D parametric CAD for sewing pattern drafting in VS Code.",
  "version": "0.0.0",
  "publisher": "yosomi",
  "private": true,
  "engines": {
    "vscode": ">=1.90.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[nui]": {
        "editor.wordBasedSuggestions": "off"
      }
    },
    "keybindings": [
      {
        "command": "nuinuiCAD.canvasUndo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' || (editorTextFocus && nuinuiCAD.canvasHistoryHandoff)"
      },
      {
        "command": "nuinuiCAD.canvasRedo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "activeWebviewPanelId == 'nuinuiCAD.canvas' || (editorTextFocus && nuinuiCAD.canvasHistoryHandoff)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nuinuiCAD.openCanvas",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.editCanvasRibbon",
          "when": "true"
        },
        {
          "command": "nuinuiCAD.goToSourceDefinition",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.revealInCanvas",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        },
        {
          "command": "nuinuiCAD.clearCanvasSelection",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.resetCanvasView",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.fitDrawing",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.toggleCanvasElementNames",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.toggleCanvasPoints",
          "when": "activeWebviewPanelId == 'nuinuiCAD.canvas'"
        },
        {
          "command": "nuinuiCAD.canvasUndo",
          "when": "false"
        },
        {
          "command": "nuinuiCAD.canvasRedo",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "nuinuiCAD.goToSourceDefinition",
          "when": "webviewId == 'nuinuiCAD.canvas'"
        }
      ],
      "editor/context": [
        {
          "command": "nuinuiCAD.revealInCanvas",
          "when": "editorLangId == nui && resourceScheme == file && resourceExtname == .nui"
        }
      ]
    },
    "commands": [
      {
        "command": "nuinuiCAD.openCanvas",
        "title": "nuinuiCAD: Open Canvas"
      },
      {
        "command": "nuinuiCAD.goToSourceDefinition",
        "title": "nuinuiCAD: Go to Source Definition"
      },
      {
        "command": "nuinuiCAD.revealInCanvas",
        "title": "nuinuiCAD: Reveal in Canvas"
      },
      {
        "command": "nuinuiCAD.canvasUndo",
        "title": "nuinuiCAD: Undo Canvas Transition"
      },
      {
        "command": "nuinuiCAD.canvasRedo",
        "title": "nuinuiCAD: Redo Canvas Transition"
      },
      {
        "command": "nuinuiCAD.clearCanvasSelection",
        "title": "nuinuiCAD: Clear Canvas Selection"
      },
      {
        "command": "nuinuiCAD.resetCanvasView",
        "title": "nuinuiCAD: Reset Canvas View"
      },
      {
        "command": "nuinuiCAD.fitDrawing",
        "title": "nuinuiCAD: Fit Drawing"
      },
      {
        "command": "nuinuiCAD.toggleCanvasElementNames",
        "title": "nuinuiCAD: Toggle Canvas Element Names"
      },
      {
        "command": "nuinuiCAD.toggleCanvasPoints",
        "title": "nuinuiCAD: Toggle Canvas Points"
      },
      {
        "command": "nuinuiCAD.editCanvasRibbon",
        "title": "nuinuiCAD: Edit Canvas Ribbon"
      }
    ],
    "configuration": {
      "title": "nuinuiCAD",
      "properties": {
        "nuinuiCAD.canvasRibbon.ribbons": {
          "type": "array",
          "scope": "application",
          "description": "Canvas Ribbons shown in the nuinuiCAD VS Code Canvas.",
          "default": [
            {
              "id": "canvas-ribbon",
              "label": "Canvas Ribbon",
              "x": null,
              "y": 12,
              "orientation": "horizontal",
              "items": [
                {
                  "id": "editCanvasRibbon",
                  "type": "command",
                  "commandId": "editCanvasRibbon",
                  "icon": "settings-2",
                  "showLabel": false
                }
              ]
            }
          ],
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["id", "label", "x", "y", "orientation", "items"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "label": { "type": "string" },
                  "x": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
                  "y": { "type": "number" },
                  "orientation": { "enum": ["horizontal", "vertical"] },
                  "items": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "required": ["id", "type", "commandId", "icon", "showLabel"],
                          "properties": {
                            "id": { "type": "string", "minLength": 1 },
                            "type": { "const": "command" },
                            "commandId": { "type": "string", "minLength": 1 },
                            "icon": { "type": "string", "minLength": 1 },
                            "showLabel": { "type": "boolean" }
                          }
                        },
                        {
                          "type": "object",
                          "required": ["id", "type", "valueId"],
                          "properties": {
                            "id": { "type": "string", "minLength": 1 },
                            "type": { "const": "value" },
                            "valueId": { "const": "canvasZoom" }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "languages": [
      {
        "id": "nui",
        "aliases": ["nuinuiCAD", "nui"],
        "extensions": [".nui"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nui",
        "scopeName": "source.nui",
        "path": "./syntaxes/nui.tmLanguage.json",
        "tokenTypes": {
          "meta.interpolation.nui": "other"
        }
      }
    ]
  },
  "scripts": {}
}
