nui 1

// 4つの点から閉じた四角形を作る
// widthを変更すると四角形の横幅が変化する
// Expected: Closed quadrilateral A=(0,0), B=(80,0), C=(80,70), D=(0,50); D–A closes automatically.
const width: number = 80
const height: number = 50

point A = coordinate(x: 0, y: 0)
point B = coordinate(x: @width, y: 0)
// 傾斜した上辺で点CとOutlineの方向・図形名表示を離す
point C = coordinate(x: @width, y: @height + 20)
point D = coordinate(x: 0, y: @height)

line Outline = polyline(
  points: [@A, @B, @C, @D],
  closed: true,
)
