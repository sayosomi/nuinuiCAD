// Choice to string. Change side to left; explicit string(@side) updates the label.
// Expected: The unnamed label reads side = right.
// string-choice: change the input values to see the result update
const side: choice(left, right) = right
const side_name: string = string(@side)
text = label(text: "side = ${@side_name}", anchor: (0, 0), size: 6)
