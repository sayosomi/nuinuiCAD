nui 1

// 2つの長さが許容誤差以内かを判定する
// actual_lengthを変更すると判定が更新される
// Expected: 53 is within 5 of 50; label true.
const expected_length: number = 50
const actual_length: number = 53
const tolerance: number = 5

const within_tolerance: boolean = isClose(
  actual_length,
  expected_length,
  tolerance,
)

line Expected = segment(
  start: (0, 0),
  end: (expected_length, 0),
)

line Actual = segment(
  start: (0, 20),
  end: (actual_length, 20),
)

text = label(
  text: "isClose = ${within_tolerance}",
  anchor: (0, 40),
  size: 6,
)
