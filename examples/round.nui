nui 1

// 小数を整数に丸める
// raw_countを変更すると線の長さも変わる
// Expected: 4.6 rounds to 5; Result length=50.
const raw_count: number = 4.6
const unit_length: number = 10

const rounded_count: number = round(@raw_count)

line Result = segment(
  start: (0, 0),
  end: (@rounded_count * @unit_length, 0),
)

text = label(
  text: "round(${@raw_count}) = ${@rounded_count}",
  anchor: (0, 25),
  size: 6,
)
