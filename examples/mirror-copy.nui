nui 1

// 半身パターンの線を個別に鏡映する表示専用ライブプレビュー
// reachを変更すると元の線とプレビューが追従する
// Expected: each member of HalfPattern is reflected across x=0 without joining.
const reach: number = 70

point AxisBottom = coordinate(x: 0, y: -20)
point AxisTop = coordinate(x: 0, y: 60)

point A = coordinate(x: 20, y: 0)
point B = coordinate(x: reach, y: 30)

line Axis = segment(
  start: AxisBottom,
  end: AxisTop,
)

group HalfPattern {
  line Base = segment(
    start: A,
    end: B,
  )
}

line Mirrored = mirrorCopy(
  axis1: AxisBottom,
  axis2: AxisTop,
  baseLines: [@HalfPattern],
)
