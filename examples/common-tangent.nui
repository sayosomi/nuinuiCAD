nui 1

// 2つの円に共通する外接線を作る
// spacingを変更すると円と接線の位置関係が変わる
// Expected: Two full circles at spacing=100; left external tangent.
const spacing: number = 100

point CenterA = coordinate(x: 0, y: 0)
point CenterB = coordinate(x: @spacing, y: 0)

arc CircleA = arc(
  center: @CenterA,
  radius: 20,
  start: 0,
  end: 360,
)

arc CircleB = arc(
  center: @CenterB,
  radius: 30,
  start: 0,
  end: 360,
)

line Tangent = commonTangent(
  first: @CircleA,
  second: @CircleB,
  kind: external,
  side: left,
)
