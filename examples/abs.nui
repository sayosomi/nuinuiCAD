nui 1

// 符号に関係なく距離の大きさを求める
// signed_heightを変更すると点の位置と絶対値が変わる
// Expected: Offset y=-30; magnitude=30; label abs(-30) = 30.
const signed_height: number = -30

const magnitude: number = abs(signed_height)

line Baseline = segment(
  start: (0, 0),
  end: (100, 0),
)

point Offset = coordinate(
  x: 40,
  y: signed_height,
)

line Guide = segment(
  start: (40, 0),
  end: Offset,
)

text = label(
  text: "abs(${ signed_height }) = ${ magnitude }",
  anchor: (0, 50),
  size: 6,
)
