nui 1

// Choice match expression. Set size=large to choose 80 mm.
// Expected: size=small selects width 40 mm.
// choice値に応じて数値を選ぶ
const size: choice(small, large) = small
const width: number = match @size {
  small => 40
  large => 80
}
line Result = segment(start: (0, 0), end: (@width, 0))
text = label(text: "width = ${@width} mm", anchor: (0, 20), size: 6)
