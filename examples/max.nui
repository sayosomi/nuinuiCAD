nui 1

// Maximum of two lengths. Change length_a or length_b; length_b=20 makes the maximum 40.
// Expected: The three lines are 40, 60 and 60 mm; max = 60 mm.
// max: change the input values to see the result update
const length_a: number = 40
const length_b: number = 60
const longer_length: number = max(@length_a, @length_b)
line A = segment(start: (0, 0), end: (@length_a, 0))
line B = segment(start: (0, 20), end: (@length_b, 20))
line Longer = segment(start: (0, 40), end: (@longer_length, 40))
text = label(text: "max = ${@longer_length} mm", anchor: (0, 65), size: 6)
