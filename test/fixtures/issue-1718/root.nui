nui 1
import "./library.nui" as library

instance Body = library::Sleeve(width: 128)
point Anchor = coordinate(x: 128, y: 0)
const Side: choice(left, right) = @left
const ChoiceValue: number = match Side {
  @left => 11
  @right => 22
}
const Forwarded: number = Body::measured
const Nested: number = if (Anchor.x > 0) {
  if (Anchor.x > 200) {
    Anchor.x + 1
  } else {
    Anchor.x + 2
  }
} else {
  Anchor.x + 3
}
const Static: number = if (true) { Anchor.x + 7 } else { Anchor.x + 9 }
