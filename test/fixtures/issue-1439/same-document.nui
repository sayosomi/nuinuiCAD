nui 1
record Corner(width: number)
record Settings(inner: Corner, maybe: Corner?, corners: Corner[], origin: point, xs: number[])
record Private(secret: number)
export module Forward(setting: Settings) {
  const local: Settings = @setting
  export const out: Settings = @local
  export const width: number = @setting.inner.width
  export const anchor: point = @setting.origin
}
export module Rows(rows: Corner[]) {
  export const out: Corner[] = @rows
}
export module Optional(setting: Corner?) {
  export const out: Corner? = @setting
}
const a: Corner = Corner(width: 7)
const b: Corner = Corner(width: 19)
point OriginLeft = coordinate(x: 3, y: 4)
point OriginRight = coordinate(x: 23, y: 29)
const short: Settings = Settings(inner: @a, corners: [@a], origin: @OriginLeft, xs: [13])
const long: Settings = Settings(inner: @b, maybe: @a, corners: [@b, @a], origin: @OriginRight, xs: [31, 37])
instance left = Forward(setting: @short)
instance right = Forward(setting: @long)
instance rows = Rows(rows: [@b, @a])
instance missing = Optional()
instance present = Optional(setting: @a)
const leftWidth: number = @left::out.inner.width
const rightWidth: number = @right::width
const leftLength: number = @left::out.xs.length
const rightLength: number = @right::out.xs.length
const rightSecond: number = @right::out.xs[1]
const selected: Corner = @rows::out[1]
const selectedWidth: number = @selected.width
const absentWidth: number = @missing::out?.width ?? 101
const presentWidth: number = @present::out?.width ?? 103
const nestedAbsent: number = @left::out.maybe?.width ?? 107
const nestedPresent: number = @right::out.maybe?.width ?? 109
const anchorX: number = @left::anchor.x
point Result = offset(from: @right::anchor, dx: @selected.width, dy: @left::out.inner.width)
