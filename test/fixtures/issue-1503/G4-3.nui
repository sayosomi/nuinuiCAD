nui 1
const width: number = 30
line Source = segment(start: (0, 0), end: (@width, 0))
move @Source(from: (0, 0), to: (10, 5), scale: 2, angleDeg: 90, mirrorX: false)
const Source_shifted: line = @Source
path Selected = from(source: @Source_shifted)
const measured: number = @Source_shifted.length
const endpoint: number = @Selected.endPoint.y
point Read = coordinate(x: @measured, y: @endpoint)
line Control = segment(start: (201, -103), end: (238, -103))
