nui 1
module Provider(turn: number, x: number) {
  export curve Edge = bezier(start: (@x, 7), end: (@x + 75, 43), startAngle: 34 + 0, startLength: 23, endAngle: 137 + 0, endLength: 27)
  export line Result = offset(sources: [@Edge.base], distance: 1.5, side: right, closed: false, suppressTrimWarnings: false)
  move Result as selected (from: (0, 0), to: (0, 0), angleDeg: @turn + 23)
  move Result as later (from: (0, 0), to: (0, 0), angleDeg: 31)
  for tick in range(min: 0, max: 1, step: 1) carry edge: path = @Result.final {
    next edge = @Result.final
  }
  export const out: path = @edge
}
instance One = Provider(turn: 0, x: 0)
instance Two = Provider(turn: 17, x: 170)
line Axis = polar(start: (430, -70), angle: 7, length: 33)
const Alias: path = @Two::out
const result: number = lineAngle(@Alias.start, @Axis.start)
