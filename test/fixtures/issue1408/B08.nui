nui 1
line Axis = polar(start: (430, -70), angle: 7, length: 33)
for i in range(min: 0, max: 1, step: 1) {
  curve Generated = bezier(start: (@i * 120, 7), end: (@i * 120 + 75, 43), startAngle: 34 + @i * 11, startLength: 23, endAngle: 137 + @i * 11, endLength: 27)
path Generated_base = from(source: @Generated[((@i - (0)) / (1))], visible: false)
  move @Generated(from: (0, 0), to: (0, 0), angleDeg: 13)
path Generated_first = from(source: @Generated[((@i - (0)) / (1))], visible: false)
path Generated_first_branch = from(source: @Generated_first[((@i - (0)) / (1))], visible: false)
  move @Generated_first_branch(from: (0, 0), to: (0, 0), angleDeg: 19)
path Generated_first_nested = from(source: @Generated_first_branch[((@i - (0)) / (1))], visible: false)
  move @Generated(from: (0, 0), to: (0, 0), angleDeg: 31)
}
module Forward(source: path) {
  for tick in range(min: 0, max: 1, step: 1) carry edge: path = @source {
    next edge = @source
  }
  export const out: path = @edge
}
instance Decoy = Forward(source: @Generated_base[0])
instance Chosen = Forward(source: @Generated_first_nested[1])
const result: number = lineAngle(@Chosen::out.start, @Axis.start)
