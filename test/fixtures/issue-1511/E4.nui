nui 1
// #1511 E4: frozen independently before product execution
line A = segment(start: (0, 0), end: (80, 0))
line B = segment(start: (30, -20), end: (30, 20))
extend A.end as First(to: (100, 0))
edge [A.First.end, B.start] as Joined(index: 0)
const Original: line = @A.base
const Checkpoint: line = @A.First
const Branch: line = @A.First.Joined
const RootFinal: line = @A.final
const BStage: line = @B.Joined
line Control = segment(start: (201, -103), end: (238, -103))
