nui 1
// #1511 E4: frozen independently before product execution
line A = segment(start: (0, 0), end: (80, 0))
const A_base: line = @A
line B = segment(start: (30, -20), end: (30, 20))
extend @A.end(to: (100, 0))
const A_First: line = @A
line A_First_branch = from(source: @A_First, visible: false)
edge [@A_First_branch.end, @B.start](index: 0)
const A_First_Joined: line = @A_First_branch
const B_Joined: line = @B
const Original: line = @A_base
const Checkpoint: line = @A_First
const Branch: line = @A_First_Joined
const RootFinal: line = @A
const BStage: line = @B_Joined
line Control = segment(start: (201, -103), end: (238, -103))
