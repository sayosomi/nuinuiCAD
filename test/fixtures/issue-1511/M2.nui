nui 1
// #1511 M2: frozen independently before product execution
line A = segment(start: (0, 0), end: (80, 0))
line B = segment(start: (30, -20), end: (30, 20))
edge [@A.end, @B.start](index: 0)
line A_Joined = from(source: @A, visible: false)
line B_Joined = from(source: @B, visible: false)
extend @A.end(to: (900, 800), enabled: false)
line A_Bypass = from(source: @A, visible: false)
line A_Joined_branch = from(source: @A_Joined, visible: false)
extend @A_Joined_branch.end(to: (47, 0))
line A_Joined_Branch = from(source: @A_Joined_branch, visible: false)
extend @A.end(to: (61, 0))
const Checkpoint: line = @A_Joined
const Branched: line = @A_Joined_Branch
const Disabled: line = @A_Bypass
point ReadBranch = onLine(from: @A_Joined_Branch.end, distance: 9)
line Control = segment(start: (201, -103), end: (238, -103))
