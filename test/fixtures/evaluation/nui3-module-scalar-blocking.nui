nui 3
point Base = coordinate(x: 10, y: 0)
module M() {
  line A = segment(start: (0, 0), end: (10, 0))
  const length: number = @A.length
  point P = coordinate(x: @length, y: 0)
}
module X = M()
module N(width: number) {
  point Q = coordinate(x: @width, y: 0)
}
module Y = N(width: @Base.x)
module LoopM() {
  for Loop (i, from: 1, count: 2, step: 1) {
    const local: number = @i
    point P = coordinate(x: @local, y: 1)
  }
}
module LoopInstance = LoopM()
module Inner(width: number = 9) {
  point NestedPoint = coordinate(x: @width, y: 2)
}
module Outer() {
  for Loop (i, from: 1, count: 2, step: 1) {
    module Nested = Inner(width: @i)
  }
}
module OuterInstance = Outer()
module Caller(x: number) {
  point CallerPoint = coordinate(x: @x, y: 3)
}
for CallerLoop (i, from: 1, count: 2, step: 1) {
  module CallerInstance = Caller(x: @i)
}
if Disabled (false) {
  module ConditionalFalse = Caller(x: 30)
}
if Enabled (true) {
  module ConditionalTrue = Caller(x: 40)
}
module Mixed(base: number) {
  for MixedLoop (i, from: 1, count: 2, step: 1) {
    const local: number = @base
    point MixedPoint = coordinate(x: @local + @i, y: 4)
  }
}
module MixedInstance = Mixed(base: 10)
module ElementLocal(width: number) {
  point ElementLocalPoint = coordinate(x: @width + @local, y: 5, vars: [local: 5])
}
module ElementLocalInstance = ElementLocal(width: 10)
module VariableInit(width: number) {
  point VariableInitPoint = coordinate(x: @local, y: 6, vars: [local: @width + 5])
}
module VariableInitInstance = VariableInit(width: 10)
