nui 1

profile Print

style Guide {
  width: 1px,
  lineType: solid,
  color: foreground,
  for @Print {
    width: 0.5px,
    lineType: dashed,
    color: warning,
  }
}

style HideInPrint {

  for @Print {
    visible: false,
  }
}

point Styled [Guide] = coordinate(x: 0, y: 0)
point ProfileHidden [HideInPrint] = coordinate(x: 10, y: 0)
point Disabled = coordinate(x: 20, y: 0, enabled: false)
point Dependent = offset(from: @Disabled, dx: 1, dy: 0)
