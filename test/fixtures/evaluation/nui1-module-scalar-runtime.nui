nui 1
// Active nui1 evaluation fixture.
const caller: number = 10
module M(value: number, side: choice(right, left), label: string) {
  const local: number = roundTo(@value, 1) + 1
  point Before = coordinate(x: @value, y: 0)
  point After = coordinate(x: @local, y: 0)
  point A = coordinate(x: 0, y: 0)
  point B = coordinate(x: 10, y: 0)
  line AB = segment(start: @A, end: @B)
  line Off = offset(sources: [@AB], distance: 2, side: @side, closed: false, suppressTrimWarnings: false)
  text Label = label(text: @label, anchor: none, size: 3)
}
instance First = M(value: round(@caller, 0), side: left, label: "first")
instance Second = M(value: 20, side: right, label: "second")
// declarative evaluation continues; source stop is no longer valid nui1 syntax
point Ignored = coordinate(x: @caller, y: 0)
