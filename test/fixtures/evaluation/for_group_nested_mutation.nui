nui 3
let total: number = 0
for Outer (i, from: 0, count: 2, step: 1) {
  if Branch (@i == 0) {
    let scratch: number = @i + 1
    set total = @total + @scratch
  } else {
    set total = @total + 10
  }
  for Inner (j, from: 0, count: 2, step: 1) {
    set total = @total + 1
    point P = coordinate(x: 0, y: 0)
  }
}
