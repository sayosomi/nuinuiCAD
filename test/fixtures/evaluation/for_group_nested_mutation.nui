nui 1
let total: number = 0
for i in range(min: 0, max: 1, step: 1) {
  if (@i == 0) {
    let scratch: number = @i + 1
    set total = @total + @scratch
  } else {
    set total = @total + 10
  }
  for j in range(min: 0, max: 1, step: 1) {
    set total = @total + 1
    point P = coordinate(x: 0, y: 0)
  }
}
