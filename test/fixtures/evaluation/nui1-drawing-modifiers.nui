nui 1
style Hide {
  visible: false,
  width: 1px,
  lineType: dashed,
  color: #aa0000,
}
style Disable {
  width: 2px,
  lineType: solid,
  color: #0000aa,
}
style Show {
  visible: true,
}
style Guide {
  width: 1.5px,
  lineType: dotted,
  color: accent,
}
module M() {
  group Inner [Disable] (enabled: false) {
    point P = coordinate(x: 1, y: 2)
  }
}
group Outer [Hide] {
  instance Use = M()
}
point Visible [Show, Guide] = coordinate(x: 3, y: 4)
