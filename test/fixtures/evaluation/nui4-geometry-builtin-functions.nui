nui 4
# Active nui4 geometry-builtin parity fixture.
point Origin = coordinate(x: 0, y: 0)
point DistanceFive = coordinate(x: 3, y: 4)
point DistanceNegative = coordinate(x: -2, y: -3)
point DistancePositive = coordinate(x: 4, y: 5)
point AngleRight = coordinate(x: 1, y: 0)
point AngleUp = coordinate(x: 0, y: 1)
point AngleLeft = coordinate(x: -1, y: 0)
point AngleDown = coordinate(x: 0, y: -1)
point AngleDiagonal = coordinate(x: 1, y: 1)
point HorizontalStart = coordinate(x: 0, y: 0)
point HorizontalEnd = coordinate(x: 1, y: 0)
point HorizontalOutside = coordinate(x: 10, y: 3)
point VerticalStart = coordinate(x: 2, y: 0)
point VerticalEnd = coordinate(x: 2, y: 10)
point VerticalOutside = coordinate(x: -3, y: 5)
point DiagonalStart = coordinate(x: 0, y: 0)
point DiagonalEnd = coordinate(x: 2, y: 2)
point DiagonalOutside = coordinate(x: 2, y: 0)
point OnLine = coordinate(x: 7, y: 0)
point ZeroLinePoint = coordinate(x: 0, y: 0)
point Disabled = coordinate(x: 9, y: 9, state: disabled)
point C = coordinate(x: 0, y: 7)
line Horizontal = segment(start: @HorizontalStart, end: @HorizontalEnd)
line Vertical = segment(start: @VerticalStart, end: @VerticalEnd)
line Diagonal = segment(start: @DiagonalStart, end: @DiagonalEnd)
line ZeroLength = segment(start: @ZeroLinePoint, end: @ZeroLinePoint)
line AB = segment(start: @Origin, end: @DistanceFive)

const distanceFive: number = distance(@Origin, @DistanceFive)
const distanceZero: number = distance(@Origin, @Origin)
const distanceTen: number = distance(@DistanceNegative, @DistancePositive)
const disabledDistance: number = distance(@Origin, @Disabled)
const derivedDistance: number = distance(@AB.start, @C)
const angleRight: number = angle(@Origin, @AngleRight)
const angleUp: number = angle(@Origin, @AngleUp)
const angleLeft: number = angle(@Origin, @AngleLeft)
const angleDown: number = angle(@Origin, @AngleDown)
const angleDiagonal: number = angle(@Origin, @AngleDiagonal)
const angleSame: number = angle(@Origin, @Origin)
const derivedAngle: number = angle(@AB.end, @C)
const lineDistanceHorizontal: number = lineDistance(@HorizontalOutside, @Horizontal)
const lineDistanceVertical: number = lineDistance(@VerticalOutside, @Vertical)
const lineDistanceDiagonal: number = lineDistance(@DiagonalOutside, @Diagonal)
const lineDistanceOnLine: number = lineDistance(@OnLine, @Horizontal)
const lineDistanceZero: number = lineDistance(@ZeroLinePoint, @ZeroLength)
const derivedLineDistance: number = lineDistance(@AB.start, @Horizontal)
let mutationValue: number = 0
set mutationValue = distance(@Origin, @DistanceFive)
