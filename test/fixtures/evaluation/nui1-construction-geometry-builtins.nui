nui 1
// #1534 and #1531: direct and const-carried independent geometry oracles.
point SP = coordinate(x: 0, y: 80)
point Guide = coordinate(x: 10, y: 40)
point DartEnd = coordinate(x: 20, y: 0)
const measuredAngle: number = angle(@DartEnd, @Guide)
curve Direct = bezier(start: @SP, end: @DartEnd, startAngle: 270, startLength: 20, endAngle: angle(@DartEnd, @Guide), endLength: 10)
curve Carried = bezier(start: @SP, end: @DartEnd, startAngle: 270, startLength: 20, endAngle: @measuredAngle, endLength: 10)
point Corner = coordinate(x: 0, y: 0)
point B = coordinate(x: 30, y: 40)
const measuredDistance: number = distance(@Corner, @B)
point P = between(start: @Corner, end: @B, distance: distance(@Corner, @B) / 3 + 5)
point CarriedP = between(start: @Corner, end: @B, distance: @measuredDistance / 3 + 5)
point Ratio = between(start: @Corner, end: @B, ratio: 1 / 3 + 5 / distance(@Corner, @B))
// Dependencies deliberately follow the consumer.
point EndpointStage = coordinate(x: distance(@L_base.start, @L.end), y: lineAngle(@L_base.start, @L.end))
point LineDistance = coordinate(x: lineDistance(@B, @L_base), y: 0)
line L = segment(start: (0, 0), end: (10, 0))
line L_base = from(source: @L, visible: false)
move @L(from: (0, 0), to: (0, 0), angleDeg: 90)
// Frame-local endpoints retain their compiled template identities.
for i in range(min: 0, max: 1, step: 1) {
  line GL = segment(start: (0, 0), end: (10, 0))
  line GV = segment(start: (0, 0), end: (0, 10))
  point GQ = coordinate(x: distance(@GL.start, @GV.end) + @GL.length, y: lineAngle(@GL.start, @GV.end))
}
