nui 1

const segmentIndex: number = 0
point Start = coordinate(x: 0, y: 0)
point End = coordinate(x: 10, y: 0)
curve Source = bezier(
  start: @Start,
  end: @End,
  startAngle: 90,
  startLength: 10,
  endAngle: -90,
  endLength: 10,
)
point Bulge = bezierBulgePoint(
  source: @Source,
  segmentIndex: @segmentIndex + 0,
)
point Mid = coordinate(x: 5, y: 7.5)
line Split = split(
  source: @Source,
  at: @Mid,
)
point SplitBulge = bezierBulgePoint(
  source: @Split,
  segmentIndex: 0,
)
line Downstream = segment(
  start: @Bulge,
  end: @End,
)
