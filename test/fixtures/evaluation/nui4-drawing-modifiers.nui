nui 4
modifier Hide {
  state: hidden,
  width: 1px,
  style: dashed,
  color: #aa0000,
}
modifier Disable {
  state: disabled,
  width: 2px,
  style: solid,
  color: #0000aa,
}
modifier Show {
  state: visible,
}
modifier Guide {
  width: 1.5px,
  style: dotted,
  color: accent,
}
module M() {
  group Inner [Disable] {
    point P = coordinate(x: 1, y: 2)
  }
}
group Outer [Hide] {
  instance Use = M()
}
point Visible [Show, Guide] = coordinate(x: 3, y: 4)
