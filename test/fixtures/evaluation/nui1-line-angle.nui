nui 1
// Active nui1 lineAngle parity fixture.
point Origin = coordinate(x: 0, y: 0)
line Horizontal = segment(start: (0, 0), end: (10, 0))
line HorizontalReversed = segment(start: (10, 5), end: (0, 5))
line Vertical = segment(start: (3, -2), end: (3, 8))
line DiagonalSeparated = segment(start: (100, 100), end: (101, 101))
line Direction135 = segment(start: (20, 20), end: (19, 21))
line DiagonalReversed = segment(start: (101, 101), end: (100, 100))
line Polar = polar(start: @Origin, angle: 45, length: 10)
line ZeroFirst = segment(start: @Origin, end: @Origin)
line ZeroSecond = segment(start: @Origin, end: @Origin)

const parallel: number = lineAngle(@Horizontal.start, @Horizontal.end)
const reversedParallel: number = lineAngle(@Horizontal.start, @HorizontalReversed.end)
const perpendicular: number = lineAngle(@Horizontal.start, @Vertical.end)
const diagonal45: number = lineAngle(@Horizontal.start, @DiagonalSeparated.end)
const directed135: number = lineAngle(@Horizontal.start, @Direction135.end)
const spatiallySeparated: number = lineAngle(@Horizontal.end, @DiagonalSeparated.start)
const reverseFirst: number = lineAngle(@HorizontalReversed.start, @DiagonalSeparated.end)
const reverseSecond: number = lineAngle(@Horizontal.end, @DiagonalReversed.start)
const swapped: number = lineAngle(@DiagonalSeparated.start, @Horizontal.end)
const polarAngle: number = lineAngle(@Horizontal.start, @Polar.end)
const zeroFirst: number = lineAngle(@ZeroFirst.start, @Horizontal.end)
const zeroSecond: number = lineAngle(@Horizontal.end, @ZeroSecond.start)
const setValue: number = lineAngle(@Horizontal.start, @Vertical.end)
