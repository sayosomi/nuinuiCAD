nui 1

layer outline_layer
layer seam_layer
layer box_layer

record seamSize(
  wide: number,
  narrow: number,
  box: number
)

const S: seamSize = seamSize(
  wide: 7,
  narrow: 1,
  box: 6.3
)

group hand {
  point base_upper = coordinate(
    x: 145.17235478117314,
    y: -44.16223524596531,
  )
  point base_lower = coordinate(
    x: 155.1297012951825,
    y: -43.81916140334289,
  )
  point tip = coordinate(
    x: 149.89953744970896,
    y: -60.14220323023001,
  )
  line baseline in @outline_layer = segment(
    start: @base_upper,
    end: @base_lower
  )
  curve outline in @outline_layer = bezier(
    start: @base_upper,
    end: @base_lower,
    startAngle: 265.2891718690955,
    startLength: 8.000952169081765,
    endAngle: 96.04100812359212,
    endLength: 8.81155513075242,
    intermediates: [knot(point: @tip, angle: 0, incoming: 3.970575729656327, outgoing: 3.515793827293661)],
  )
  group box {
    const left_x: number =  @base_upper.x - @S.box
    const right_x: number =  @base_lower.x + @S.box
    const bottom_y: number = @tip.y - @S.box
    point left_bottom = coordinate(
      x: @left_x,
      y: @bottom_y
    )
    point right_bottom = coordinate(
      x: @right_x,
      y: @bottom_y
    )
    const top_y: number = @base_lower.y + @S.wide + 2.7
    point left_top = coordinate(
      x: @left_x,
      y: @top_y
    )
    point right_top = coordinate(
      x: @right_x,
      y: @top_y
    )
    line border in @box_layer = polyline(points: [@left_top, @right_top, @right_bottom, @left_bottom], closed: true)
  }
}
