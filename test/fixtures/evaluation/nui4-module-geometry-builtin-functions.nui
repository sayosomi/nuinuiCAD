nui 4
point P = coordinate(x: 3, y: 4)
point Origin = coordinate(x: 0, y: 0)
point Diagonal = coordinate(x: 1, y: 1)
point MeasurePoint = coordinate(x: 10, y: 3)
line Baseline = segment(start: (0, 0), end: (1, 0))

module Child() {
  export point ExportedPoint = coordinate(x: 3, y: 4)
  export line ExportedLine = segment(start: (0, 0), end: (1, 0))
}

module Example(p: point, origin: point, baseline: line, diagonal: point, measuredPoint: point) {
  point LocalOrigin = coordinate(x: 0, y: 0)
  point LocalPoint = coordinate(x: 3, y: 4)
  line LocalLine = segment(start: (0, 0), end: (0, 2))
  instance ChildInstance = Child()
  const radius: number = distance(@origin, @p)
  const direction: number = angle(@origin, @diagonal)
  const height: number = lineDistance(@measuredPoint, @baseline)
  const localDistance: number = distance(@LocalOrigin, @LocalPoint)
  const childDistance: number = distance(@ChildInstance::ExportedPoint, @LocalOrigin)
  const childLineDistance: number = lineDistance(@LocalPoint, @ChildInstance::ExportedLine)
  const parameterStartDistance: number = distance(@baseline.start, @LocalLine.end)
  const parameterEndAngle: number = angle(@baseline.end, @LocalLine.start)
  const localEndpointLineDistance: number = lineDistance(@LocalLine.end, @baseline)
  let measured: number = 0
  set measured = distance(@origin, @p)
  export point ExportedPoint = coordinate(x: 3, y: 4)
  export line ExportedLine = segment(start: (0, 0), end: (1, 0))
}

instance ExampleInstance = Example(p: @P, origin: @Origin, baseline: @Baseline, diagonal: @Diagonal, measuredPoint: @MeasurePoint)
const rootDistance: number = distance(@ExampleInstance::ExportedPoint, @Origin)
const rootLineDistance: number = lineDistance(@MeasurePoint, @ExampleInstance::ExportedLine)
