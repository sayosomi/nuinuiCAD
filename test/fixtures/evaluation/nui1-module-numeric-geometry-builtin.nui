nui 1

point P = coordinate(x: 3, y: 4)

line Baseline = segment(
  start: (0, 0),
  end: (1, 0)
)

module Example(
  baseline: line,
  p: point,
  delta: number
) {
  let measured: number = 0
  set measured = distance(@baseline.start, @p)

  export point Q = coordinate(
    x: @measured + @delta,
    y: lineDistance(@p, @baseline)
  )
}

instance Use = Example(
  baseline: @Baseline,
  p: @P,
  delta: 2
)

point ExpectedModuleQ = coordinate(x: 7, y: 4)

const moduleCheck: number = distance(
  @Use::Q,
  @ExpectedModuleQ
)
