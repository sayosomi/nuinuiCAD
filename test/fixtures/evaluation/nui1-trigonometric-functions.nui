nui 1

const sin30: number = sin(30)
const cos60: number = cos(60)
const tan45: number = tan(45)

const asinHalf: number = asin(0.5)
const acosHalf: number = acos(0.5)
const atanOne: number = atan(1)

const atan2Right: number = atan2(0, 1)
const atan2Up: number = atan2(1, 0)
const atan2Left: number = atan2(0, -1)
const atan2Down: number = atan2(-1, 0)
const atan2Diagonal: number = atan2(1, 1)
const atan2Zero: number = atan2(0, 0)

const tanInvalid90: number = tan(90)
const tanInvalid270: number = tan(270)
const tanInvalidNegative90: number = tan(-90)

const asinInvalidLow: number = asin(-1.1)
const asinInvalidHigh: number = asin(1.1)
const acosInvalidLow: number = acos(-1.1)
const acosInvalidHigh: number = acos(1.1)

const nestedTrig: number = round(asin(sin(30)), 6)

let mutableAngle: number = 0
set mutableAngle = atan2(-1, 0)
const referenceTrig: number = sin(@mutableAngle)

point Origin = coordinate(
  x: cos(60),
  y: sin(30),
)

point End = coordinate(
  x: 10,
  y: 0,
)

line Base = segment(
  start: @Origin,
  end: @End,
)

line TrigOffset = offset(
  sources: [@Base],
  distance: sin(30),
  side: right,
  closed: false,
  suppressTrimWarnings: false,
)

text TrigTemplate = label(
  text: "sin30=${@sin30}",
  anchor: none,
  size: 3,
)

module TrigModule(value: number) {
  const local: number = sin(@value)

  point ModulePoint = coordinate(
    x: @local,
    y: 0,
  )
}

instance TrigInstance = TrigModule(
  value: 30,
)

group Pattern {
  point P2 = coordinate(
    x: 8,
    y: 2,
  )

  line Edge = segment(
    start: @Origin,
    end: @P2,
  )
}

stop
