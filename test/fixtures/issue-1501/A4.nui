nui 1
// #1501 A4: frozen independently before product execution
arc Source = arc(center: (11, -9), radius: 43, start: 317, end: 445, direction: counterclockwise)
const Source_base: path = @Source
move @Source(from: (0, 0), to: (17, -23))
const Source_shifted: path = @Source
const Selected: path = @Source_base
const Alternate: path = @Source_shifted
point Cut = onLine(from: @Selected.start, ratio: 0.37)
line Far = split(source: @Source_base, at: @Cut)
line Control = segment(start: (201, -103), end: (238, -103))
