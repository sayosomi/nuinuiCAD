nui 1
// #1499 B1 independently sealed before evaluator execution
curve A = bezier(start: (0, -32), end: (120, 32), startAngle: 65.55604521958347, startLength: 96.66436778875658, endAngle: 65.55604521958347, endLength: 96.66436778875658)
line B = segment(start: (-10, 0), end: (130, 0))
point P0 = intersection(line1: @A, line2: @B, index: 0, extensions: false)
point P1 = intersection(line1: @A, line2: @B, index: 1, extensions: false)
point P2 = intersection(line1: @A, line2: @B, index: 2, extensions: false)
point Absent = intersection(line1: @A, line2: @B, index: 3, extensions: false)
line Control = segment(start: (201, -103), end: (238, -103))
