nui 1
// Issue #1519 composition B v1; 32 runtime drawables; explicit geometry.
const width: number = 48
point ControlA = coordinate(x: 0, y: 20)
point ControlB = offset(from: @ControlA, dx: 40, dy: 0)
point ControlN0 = offset(from: @ControlA, dx: 40 / 2, dy: 0)
point ControlN1 = offset(from: @ControlN0, dx: 0, dy: -2)
line ControlEdge = segment(start: @ControlA, end: @ControlB)
curve ControlCurve = bezier(start: @ControlA, end: @ControlB, startAngle: 90, startLength: 12, endAngle: 270, endLength: 12)
line ControlSeam = offset(sources: [@ControlEdge], distance: 3, side: left, closed: false)
line ControlNotch = segment(start: @ControlN0, end: @ControlN1)
const ControlseamLength: number = @ControlSeam.length
const ControlcurveLength: number = @ControlCurve.length
point I0A = coordinate(x: 0, y: -40)
point I0B = offset(from: @I0A, dx: @width, dy: 0)
point I0N0 = offset(from: @I0A, dx: @width / 2, dy: 0)
point I0N1 = offset(from: @I0N0, dx: 0, dy: -2)
line I0Edge = segment(start: @I0A, end: @I0B)
curve I0Curve = bezier(start: @I0A, end: @I0B, startAngle: 90, startLength: 12, endAngle: 270, endLength: 12)
line I0Seam = offset(sources: [@I0Edge], distance: 3, side: left, closed: false)
line I0Notch = segment(start: @I0N0, end: @I0N1)
const I0seamLength: number = @I0Seam.length
const I0curveLength: number = @I0Curve.length
point I1A = coordinate(x: 0, y: -80)
point I1B = offset(from: @I1A, dx: @width, dy: 0)
point I1N0 = offset(from: @I1A, dx: @width / 2, dy: 0)
point I1N1 = offset(from: @I1N0, dx: 0, dy: -2)
line I1Edge = segment(start: @I1A, end: @I1B)
curve I1Curve = bezier(start: @I1A, end: @I1B, startAngle: 90, startLength: 12, endAngle: 270, endLength: 12)
line I1Seam = offset(sources: [@I1Edge], distance: 3, side: left, closed: false)
line I1Notch = segment(start: @I1N0, end: @I1N1)
const I1seamLength: number = @I1Seam.length
const I1curveLength: number = @I1Curve.length
point I2A = coordinate(x: 0, y: -120)
point I2B = offset(from: @I2A, dx: @width, dy: 0)
point I2N0 = offset(from: @I2A, dx: @width / 2, dy: 0)
point I2N1 = offset(from: @I2N0, dx: 0, dy: -2)
line I2Edge = segment(start: @I2A, end: @I2B)
curve I2Curve = bezier(start: @I2A, end: @I2B, startAngle: 90, startLength: 12, endAngle: 270, endLength: 12)
line I2Seam = offset(sources: [@I2Edge], distance: 3, side: left, closed: false)
line I2Notch = segment(start: @I2N0, end: @I2N1)
const I2seamLength: number = @I2Seam.length
const I2curveLength: number = @I2Curve.length
