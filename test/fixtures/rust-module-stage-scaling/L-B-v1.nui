line I62Seam = offset(sources: [@I62Edge], distance: 3, side: left, closed: false)
line I62Notch = segment(start: @I62N0, end: @I62N1)
const I62seamLength: number = @I62Seam.length
const I62curveLength: number = @I62Curve.length
