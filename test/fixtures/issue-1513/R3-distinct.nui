nui 1
// #1513 R3-distinct: oracle frozen before evaluation
line A = segment(start: (0, 0), end: (100, 0))
const A_base: line = @A
line B = segment(start: (100, 0), end: (100, 60))
extend @A.end(to: (120, 0))
const A_Kept: line = @A
arc R = corner(end1: @A.end, end2: @B.start, radius: 10)
const Original: line = @A_base
const Named: line = @A_Kept
const Final: line = @A
line Control = segment(start: (201, -103), end: (238, -103))
