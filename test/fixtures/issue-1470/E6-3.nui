nui 1
// Frozen #1470 E6
curve Curve = bezier(start: (0, 0), end: (60, 10), startAngle: 90, startLength: 12, endAngle: -90, endLength: 16, intermediates: [knot(point: (20, 0), angle: 0, incoming: 5, outgoing: 9)])
line Tail = split(source: @Curve, at: (8.125, 4.5))
extend @Tail.end (to: (60, 2))
move @Tail(from: (0, 0), to: (7, 9))
const Tail_shifted: path = @Tail
point Result = bezierExtremePoint(source: @Tail_shifted, segmentIndex: 1, direction: 90)
curve ControlCurve = bezier(start: (0, 0), end: (40, 0), startAngle: 85.236358309273825, startLength: 36.124783736376884, endAngle: -53.13010235415598, endLength: 15)
point Control = bezierExtremePoint(source: @ControlCurve, direction: 90)
