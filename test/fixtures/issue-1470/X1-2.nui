module M(index: number) {
  const Local: path = bezier(start: (0, 0), end: (40, 0), startAngle: 85.236358309273825, startLength: 36.124783736376884, endAngle: -53.13010235415598, endLength: 15)
  export const Path: path = @Local
  export const Out: point = bezierBulgePoint(source: @Local, segmentIndex: @index)
