reverse Arc ()
reverse S0 ()
line Reversed = offset(sources: [@S0, @Arc], distance: 2, side: right, closed: false, suppressTrimWarnings: false)
line Control = segment(start: (201, -103), end: (238, -103))
line ControlOffset = offset(sources: [@Control], distance: 7, side: right)
