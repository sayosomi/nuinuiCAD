nui 1
// #1495 B2; sealed before production evaluation
curve Curve = bezier(start: (0, 0), end: (60, 20), startAngle: 63.43494882292201, startLength: 33.54101966249684, endAngle: 165.96375653207352, endLength: 20.615528128088304)
line S0 = segment(start: (60, 20), end: (60, 70))
line Seam = offset(sources: [@Curve.base, @S0.base], distance: 2, side: right, closed: false, suppressTrimWarnings: false)
reverse Curve ()
reverse S0 ()
line Reversed = offset(sources: [@S0, @Curve], distance: 2, side: left, closed: false, suppressTrimWarnings: false)
line Control = segment(start: (201, -103), end: (238, -103))
line ControlOffset = offset(sources: [@Control], distance: 7, side: right)
