nui 1
// #1495 A4; sealed before production evaluation
line S0 = segment(start: (-30, -20), end: (0, 0))
arc Arc = arc(center: (0, 20), radius: 20, start: 270, end: 0, direction: counterclockwise)
line Tail = segment(start: (20, 20), end: (42, 48))
line Seam = offset(sources: [@S0, @Arc, @Tail], distance: 3, side: right, closed: false, suppressTrimWarnings: false)
line BadTail = segment(start: (20,20), end: (42,48))
line Invalid = offset(sources: [@S0, @Arc, @BadTail], distance: 3, side: right, closed: false, suppressTrimWarnings: false)
line Control = segment(start: (201, -103), end: (238, -103))
line ControlOffset = offset(sources: [@Control], distance: 7, side: right)
