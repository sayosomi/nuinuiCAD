{
  "name": "nuinuicad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run build:mcp",
    "build:mcp": "tsc -p mcp-server/tsconfig.json && esbuild mcp-server/src/server.ts --bundle --platform=node --format=esm --target=node24 --outfile=mcp-server/dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:stress:lifecycle": "node scripts/ci/runLifecycleStress.mjs",
    "test:performance:reconciler": "VITE_RUN_PERFORMANCE_GATES=1 vitest run src/document/statementReconciler.performance.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:performance:rename-propagation": "VITE_RUN_PERFORMANCE_GATES=1 vitest run src/commands/renamePropagationCoverage.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:performance:shadow-commit": "VITE_RUN_PERFORMANCE_GATES=1 vitest run src/document/shadowCommitCost.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:performance:source-editor-cutover": "VITE_RUN_PERFORMANCE_GATES=1 vitest run src/editor/sourceEditorCutoverCost.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:performance:typed-value-candidates": "VITE_RUN_PERFORMANCE_GATES=1 vitest run src/scalars/typedValueCandidates.performance.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:performance:expression-evaluator": "VITE_RUN_PERFORMANCE_GATES=1 vitest run src/scalars/expressionEvaluator.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:performance:codemirror-foundation": "VITE_RUN_PERFORMANCE_GATES=1 vitest run src/editor/codemirrorFoundationCost.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:performance:rename-analysis": "VITE_RUN_PERFORMANCE_GATES=1 vitest run src/document/renameAnalysis.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:performance:binding-analysis": "VITE_RUN_PERFORMANCE_GATES=1 vitest run test/typedVariablesPureBindingAnalysisPerformance.test.ts src/scalars/typedDependencyGraph.performance.test.ts src/scalars/typedRenameAnalysis.performance.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:profile:binding-analysis": "VITE_RUN_BINDING_PROFILE=1 vitest run test/typedVariablesPureBindingAnalysisProfile.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:performance:for-group-mutation": "VITE_RUN_PERFORMANCE_GATES=1 vitest run test/typedVariablesForGroupMutationProductionPerformance.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "bench:performance:rust-production": "cargo test --manifest-path rust-evaluator/Cargo.toml performance_pure_typed_production_ -- --ignored --nocapture --test-threads=1",
    "test:parity": "VITE_RUN_RUST_PARITY=1 vitest run test/evaluationParity.test.ts",
    "bench:evaluation": "cargo test --manifest-path rust-evaluator/Cargo.toml performance_ -- --ignored --nocapture --test-threads=1",
    "bench:compare": "tsx scripts/performance/compare.ts",
    "bench:capture:vscode": "tsx scripts/performance/captureVscode.ts",
    "build:vscode": "node scripts/vscode/build.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^1.21.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "^4.4.3",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/vscode": "^1.103.2",
    "esbuild": "^0.28.2",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "fast-check": "^4.9.0",
    "globals": "latest",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
