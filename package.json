{
  "name": "nuinuicad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "desktop:dev": "tauri dev",
    "desktop:dev:parity": "VITE_EVALUATION_ENGINE=parity npm run desktop:dev",
    "desktop:dev:shadow": "VITE_EVALUATION_ENGINE=shadow npm run desktop:dev",
    "desktop:dev:rust": "VITE_EVALUATION_ENGINE=rust npm run desktop:dev",
    "desktop:build": "tauri build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:performance:reconciler": "vitest run src/document/statementReconciler.performance.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:performance:codemirror-foundation": "VITE_RUN_PERFORMANCE_GATES=1 vitest run src/editor/codemirrorFoundationCost.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:performance:rename-analysis": "VITE_RUN_PERFORMANCE_GATES=1 vitest run src/document/renameAnalysis.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:performance:binding-analysis": "VITE_RUN_PERFORMANCE_GATES=1 vitest run test/typedVariablesPureNui3BindingAnalysisPerformance.test.ts src/scalars/typedDependencyGraph.performance.test.ts src/scalars/typedRenameAnalysis.performance.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:profile:binding-analysis": "VITE_RUN_BINDING_PROFILE=1 vitest run test/typedVariablesPureNui3BindingAnalysisProfile.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "test:performance:for-group-mutation": "VITE_RUN_PERFORMANCE_GATES=1 vitest run test/typedVariablesForGroupMutationProductionPerformance.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism --disableConsoleIntercept",
    "bench:performance:rust-production": "cargo test --manifest-path src-tauri/Cargo.toml performance_pure_nui3_typed_production_ -- --ignored --nocapture --test-threads=1",
    "test:parity": "VITE_RUN_RUST_PARITY=1 vitest run test/evaluationParity.test.ts",
    "bench:evaluation": "cargo test --manifest-path src-tauri/Cargo.toml performance_ -- --ignored --nocapture --test-threads=1",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^1.21.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "fast-check": "^4.9.0",
    "globals": "latest",
    "jsdom": "^29.1.1",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
