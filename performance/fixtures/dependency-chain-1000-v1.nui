nui 4

const benchOffset: number = 6

group Benchmark {
  point DragPoint = coordinate(
    x: 0,
    y: 0
  )

  point CurveEnd = offset(
    from: @DragPoint,
    dx: 120,
    dy: 40
  )

  line Baseline = segment(
    start: @DragPoint,
    end: @CurveEnd
  )

  curve DragCurve = bezier(
    start: @DragPoint,
    end: @CurveEnd,
    startAngle: 25,
    startLength: 45,
    endAngle: 200,
    endLength: 40
  )

  line DependentOffset = offset(
    sources: [@DragCurve],
    distance: @benchOffset,
    side: left,
    closed: false,
    suppressTrimWarnings: true
  )
}

group Load {
  for i in range(from: 0, count: 1, step: 1) {
