nui 3

# 実用途の凸ノッチ。Bezierの縫い線をpath parameterへ渡し、
# Module内で接線方向・交点・延長を使って2つの独立したノッチを作る。
const 凸ノッチ高さ: number = 9
const 縫い代幅: number = 5

point 点A = coordinate(
  x: 50,
  y: -50
)

point 点B = offset(
  from: @点A,
  dx: 100,
  dy: 0
)

curve 縫い線 = bezier(
  start: @点A,
  end: @点B,
  startAngle: 270,
  startLength: 50,
  endAngle: 90,
  endLength: 50
)

line 縫い代線 = offset(
  sources: [@縫い線],
  distance: @縫い代幅,
  side: left,
  closed: false
)

point ノッチ位置 = onLine(
  from: @縫い線.start,
  ratio: 0.5,
  steps: [ratio: 0.01]
)

module 凸ノッチ(凸ノッチ高さ: number, 縫い線: path, 縫い代線: path, ノッチ位置: point, 反転: boolean = false) {
  let 方向: number = 270
  if 反転判定 (@反転 == true) {
    set 方向 = 90
  }

  point 頭 = tangentOffset(
  line: @縫い線,
    base: @ノッチ位置,
    angle: @方向,
    distance: @凸ノッチ高さ
  )

  point しっぽ = tangentOffset(
  line: @縫い線,
    base: @ノッチ位置,
    angle: @方向 - 180,
    distance: @凸ノッチ高さ / 4
  )

  line 中心 = segment(
    start: @頭,
    end: @しっぽ
  )

  line サイド1 = polar(
    start: @頭,
    angle: @中心.startAngleDeg + 30,
    length: 100
  )

  line サイド2 = polar(
    start: @頭,
    angle: @中心.startAngleDeg - 30,
    length: 100
  )

  point 交点1 = intersection(
    line1: @サイド1,
    line2: @縫い代線,
    index: 0,
    extensions: false
  )

  point 交点2 = intersection(
    line1: @サイド2,
    line2: @縫い代線,
    index: 0,
    extensions: false
  )

  extend(
    end: @サイド1.end,
    to: @交点1
  )

  extend(
    end: @サイド2.end,
    to: @交点2
  )
}

module ノッチ通常 = 凸ノッチ(
  凸ノッチ高さ: @凸ノッチ高さ,
  縫い線: @縫い線,
  縫い代線: @縫い代線,
  ノッチ位置: @ノッチ位置,
  反転: false
)

module ノッチ反転 = 凸ノッチ(
  凸ノッチ高さ: @凸ノッチ高さ,
  縫い線: @縫い線,
  縫い代線: @縫い代線,
  ノッチ位置: @ノッチ位置,
  反転: true
)
