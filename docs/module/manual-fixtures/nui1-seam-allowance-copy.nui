nui 1

// 前身頃と後ろ身頃の縫い線を使う、nui1実用途の縫い代写し。
const 縫い代幅: number = 5

module 縫い代写し(基準点: point, 写し元縫い線: path, 合わせ先縫い線: path, 写し元先に縫う縫い代線: path, 写し元後で縫う縫い代線: path, mirrorX: boolean = false) {
  transformCopy 写し_脇コピー(
    startPoint: 基準点,
    endPoint: 合わせ先縫い線.end,
    scale: 1,
    angleDeg: 0,
    mirrorX: mirrorX,
    parts: [脇コピー: 写し元縫い線]
  )

  const 角度: number = 合わせ先縫い線.endAngleDeg - 写し_脇コピー::脇コピー.endAngleDeg

  transformCopy 写し_先に縫う(
    startPoint: 基準点,
    endPoint: 写し_脇コピー::脇コピー.end,
    scale: 1,
    angleDeg: 角度,
    mirrorX: false,
    visible: false,
    parts: [part: 写し元先に縫う縫い代線]
  )
  export path 先に縫う = from(source: 写し_先に縫う::part)

  transformCopy 写し_後で縫う(
    startPoint: 基準点,
    endPoint: 写し_脇コピー::脇コピー.end,
    scale: 1,
    angleDeg: 角度,
    mirrorX: false,
    visible: false,
    parts: [part: 写し元後で縫う縫い代線]
  )
  export path 後で縫う = from(source: 写し_後で縫う::part)
}

group 前身頃 {
  point 点A = coordinate(
    x: 50,
    y: -50
  )

  point 点B = offset(
    from: 点A,
    dx: 100,
    dy: 0
  )

  curve 後で縫う = bezier(
    start: 点A,
    end: 点B,
    startAngle: 270,
    startLength: 50,
    endAngle: 59,
    endLength: 58
  )

  point 点C = coordinate(
    x: 100,
    y: -50
  )

  point 点D = coordinate(
    x: 60,
    y: -110
  )

  curve 先に縫う = bezier(
    start: 点C,
    end: 点D,
    startAngle: 318,
    startLength: 28,
    endAngle: 168,
    endLength: 36
  )

  point 交点 = intersection(
    line1: 後で縫う,
    line2: 先に縫う,
    index: 0,
    extensions: false
  )

  group 縫い代 {
    line 先に縫う = offset(
      sources: [前身頃::先に縫う],
      distance: 縫い代幅,
      side: @right,
      closed: false
    )

    line 後で縫う = offset(
      sources: [前身頃::後で縫う],
      distance: 縫い代幅,
      side: @left,
      closed: false
    )

  }
}

group 後ろ身頃 {
  line 後で縫う = split(
    source: 前身頃::後で縫う,
    at: 前身頃::交点
  )

  transformCopy 写し_先に縫う(
    startPoint: 前身頃::交点,
    endPoint: 後で縫う.start,
    scale: 1,
    angleDeg: 11,
    mirrorX: true,
    parts: [先に縫う: 前身頃::先に縫う]
  )

  group 縫い代 {
    line 先に縫う = offset(
      sources: [後ろ身頃::写し_先に縫う::先に縫う],
      distance: 縫い代幅,
      side: @right,
      closed: false
    )

    line 後で縫う = offset(
      sources: [後ろ身頃::後で縫う],
      distance: 縫い代幅,
      side: @right,
      closed: false
    )

    instance 写し = 縫い代写し(
      基準点: 前身頃::交点,
      写し元縫い線: 前身頃::先に縫う,
      合わせ先縫い線: 後ろ身頃::写し_先に縫う::先に縫う,
      写し元先に縫う縫い代線: 前身頃::縫い代::先に縫う,
      写し元後で縫う縫い代線: 前身頃::縫い代::後で縫う,
      mirrorX: true
    )

  }
}
