nui 3

# 前身頃と後ろ身頃の縫い線を使う、実用途の縫い代写し。
const 縫い代幅: number = 5

module 縫い代写し(基準点: point, 写し元縫い線: line, 合わせ先縫い線: line, 写し元先に縫う縫い代線: line, 写し元後で縫う縫い代線: line, mirrorX: boolean = false) {
  line 脇コピー = copy(
    startPoint: @基準点,
    endPoint: @合わせ先縫い線.end,
    scale: 1,
    angleDeg: 0,
    mirrorX: @mirrorX,
    baseLines: [@写し元縫い線]
  )

  const 角度: number = @合わせ先縫い線.endTangentAngleDeg - @脇コピー.endTangentAngleDeg

  move(
    targets: [@脇コピー],
    from: @脇コピー.end,
    to: @脇コピー.end,
    scale: 1,
    angleDeg: @角度,
    mirrorX: false
  )

  export line 先に縫う = copy(
    startPoint: @基準点,
    endPoint: @脇コピー.end,
    scale: 1,
    angleDeg: @角度,
    mirrorX: false,
    baseLines: [@写し元先に縫う縫い代線]
  )

  export line 後で縫う = copy(
    startPoint: @基準点,
    endPoint: @脇コピー.end,
    scale: 1,
    angleDeg: @角度,
    mirrorX: false,
    baseLines: [@写し元後で縫う縫い代線]
  )
}

group 前身頃 {
  point 点A = coordinate(
    x: 50,
    y: -50
  )

  point 点B = offset(
    from: @点A,
    dx: 100,
    dy: 0
  )

  curve 後で縫う = bezier(
    start: @点A,
    end: @点B,
    startAngle: 270,
    startLength: 50,
    endAngle: 59,
    endLength: 58
  )

  point 点C = coordinate(
    x: 100,
    y: -50
  )

  point 点D = coordinate(
    x: 60,
    y: -110
  )

  curve 先に縫う = bezier(
    start: @点C,
    end: @点D,
    startAngle: 318,
    startLength: 28,
    endAngle: 168,
    endLength: 36
  )

  point 交点 = intersection(
    line1: @後で縫う,
    line2: @先に縫う,
    index: 0,
    extensions: false
  )

  extend(
    end: @先に縫う.end,
    to: @交点
  )

  group 縫い代 {
    line 先に縫う = offset(
      sources: [@前身頃::先に縫う],
      distance: @縫い代幅,
      side: right,
      closed: false
    )

    line 後で縫う = offset(
      sources: [@前身頃::後で縫う],
      distance: @縫い代幅,
      side: left,
      closed: false
    )

    edge(
      end1: @後で縫う.end,
      end2: @先に縫う.end,
      index: 1
    )
  }
}

group 後ろ身頃 {
  line 後で縫う = split(
    source: @前身頃::後で縫う,
    at: @前身頃::交点
  )

  move(
    targets: [@後で縫う],
    from: @前身頃::交点,
    to: (0, 0),
    scale: 1,
    angleDeg: 11,
    mirrorX: true
  )

  line 先に縫う = copy(
    startPoint: @前身頃::交点,
    endPoint: @後で縫う.start,
    scale: 1,
    angleDeg: 11,
    mirrorX: true,
    baseLines: [@前身頃::先に縫う]
  )

  group 縫い代 {
    line 先に縫う = offset(
      sources: [@後ろ身頃::先に縫う],
      distance: @縫い代幅,
      side: right,
      closed: false
    )

    line 後で縫う = offset(
      sources: [@後ろ身頃::後で縫う],
      distance: @縫い代幅,
      side: right,
      closed: false
    )

    module 写し = 縫い代写し(
      基準点: @前身頃::交点,
      写し元縫い線: @前身頃::先に縫う,
      合わせ先縫い線: @後ろ身頃::先に縫う,
      写し元先に縫う縫い代線: @前身頃::縫い代::先に縫う,
      写し元後で縫う縫い代線: @前身頃::縫い代::後で縫う,
      mirrorX: true
    )

    edge(
      end1: @先に縫う.end,
      end2: @写し::先に縫う.start,
      index: 1
    )

    edge(
      end1: @後で縫う.start,
      end2: @写し::後で縫う.start,
      index: 0
    )
  }
}
