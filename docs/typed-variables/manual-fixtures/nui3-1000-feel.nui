nui 3
const offsetY: number = 3
let counter: number = 0
text Summary = label(text: "counter={@counter} offsetY={@offsetY}" anchor: none size: 4)

color main ("#31322f" name: "基本線" default: true)
color accent ("#b42318" name: "裁断線")

role seam (name: "縫い代")
view 通常 (default: true seam: false)
view 印刷 (default: true seam: true)
activeView 通常

