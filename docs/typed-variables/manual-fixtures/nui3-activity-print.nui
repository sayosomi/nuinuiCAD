nui 3

view Print (default: true)

let printVisible: boolean = true
let printHidden: boolean = false

group Visible (printEnabled: @printVisible) {
  point VA = coordinate(x: 0 y: 0)
  point VB = coordinate(x: 40 y: 0)
  line VisibleLine = segment(start: @VA end: @VB)
}

group Hidden (state: hidden printEnabled: @printVisible) {
  point HA = coordinate(x: 0 y: 10)
  point HB = coordinate(x: 40 y: 10)
  line HiddenLine = segment(start: @HA end: @HB)
}

group Disabled (state: disabled printEnabled: @printVisible) {
  point DA = coordinate(x: 0 y: 20)
  point DB = coordinate(x: 40 y: 20)
  line DisabledLine = segment(start: @DA end: @DB)
}

group NotPrinted (printEnabled: @printHidden) {
  point NA = coordinate(x: 0 y: 30)
  point NB = coordinate(x: 40 y: 30)
  line NotPrintedLine = segment(start: @NA end: @NB)
}

printLayout Test (
  output: pdf
  view: Print
  paper: a4
  orientation: portrait
  columns: 1
  rows: 1
  overlap: 0
  scale: 1
  canvas: (210, 297)
) {
  place Visible (at: (20, 40) angle: 0 mirrorX: false)
  place Hidden (at: (20, 70) angle: 0 mirrorX: false)
  place Disabled (at: (20, 100) angle: 0 mirrorX: false)
  place NotPrinted (at: (20, 130) angle: 0 mirrorX: false)
}

activePrintLayout Test
