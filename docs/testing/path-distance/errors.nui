nui 1
line Route = segment(start: (0, 0), end: (100, 0))
point On = coordinate(x: 20, y: 0)
point Off = coordinate(x: 70, y: 5)
const offFirst: number = pathDistance(path: @Route, point1: @Off, point2: @On)
const offSecond: number = pathDistance(path: @Route, point1: @On, point2: @Off)
line Crossing = polyline(points: [(0, -30), (20, -10), (0, -10), (20, -30)], closed: false)
point Cross = coordinate(x: 10, y: -20)
const ambiguous: number = pathDistance(path: @Crossing, point1: @Cross, point2: @Cross)
const healthy: number = pathDistance(path: @Route, point1: @Route.start, point2: @Route.end)
text = label(anchor: (0, -40), text: "Healthy ${@healthy} mm; expected 100. Three independent failed bindings above.")
