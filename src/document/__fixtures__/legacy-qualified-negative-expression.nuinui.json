{
  "app": "nuinuiCAD",
  "schemaVersion": 5,
  "document": {
    "elements": [
      {
        "id": "point-a",
        "name": "始点",
        "type": "freePoint",
        "visible": true,
        "enabled": true,
        "x": 0,
        "y": 0
      },
      {
        "id": "point-b",
        "name": "終点",
        "type": "freePoint",
        "visible": true,
        "enabled": true,
        "x": 100,
        "y": 0
      },
      {
        "id": "base-line",
        "name": "外形",
        "type": "line",
        "visible": true,
        "enabled": true,
        "startPoint": { "mode": "reference", "pointId": "point-a" },
        "endPoint": { "mode": "reference", "pointId": "point-b" }
      },
      {
        "id": "group-tights",
        "name": "タイツ",
        "type": "group",
        "visible": true,
        "enabled": true,
        "printEnabled": false,
        "printAnchor": { "mode": "coordinate", "x": 0, "y": 0 }
      },
      {
        "id": "group-seam",
        "name": "縫い代",
        "type": "group",
        "visible": true,
        "enabled": true,
        "parentGroupId": "group-tights",
        "printEnabled": false,
        "printAnchor": { "mode": "coordinate", "x": 0, "y": 0 }
      },
      {
        "id": "group-notch",
        "name": "凸ノッチ",
        "type": "group",
        "visible": true,
        "enabled": true,
        "parentGroupId": "group-seam",
        "printEnabled": false,
        "printAnchor": { "mode": "coordinate", "x": 0, "y": 0 }
      },
      {
        "id": "notch-height",
        "name": "高さ",
        "type": "variable",
        "visible": true,
        "enabled": true,
        "parentGroupId": "group-notch",
        "scope": "group",
        "valueMode": "expression",
        "expression": 10,
        "point1": { "mode": "reference", "pointId": "point-a" },
        "point2": { "mode": "reference", "pointId": "point-b" },
        "point": { "mode": "reference", "pointId": "point-a" },
        "lineId": "base-line"
      },
      {
        "id": "notch-angle",
        "name": "方向",
        "type": "variable",
        "visible": true,
        "enabled": true,
        "parentGroupId": "group-notch",
        "scope": "group",
        "valueMode": "expression",
        "expression": 270,
        "point1": { "mode": "reference", "pointId": "point-a" },
        "point2": { "mode": "reference", "pointId": "point-b" },
        "point": { "mode": "reference", "pointId": "point-a" },
        "lineId": "base-line"
      },
      {
        "id": "tail",
        "name": "しっぽ",
        "type": "lineTangentOffsetPoint",
        "visible": true,
        "enabled": true,
        "parentGroupId": "group-notch",
        "baseLineId": "base-line",
        "basePoint": { "mode": "reference", "pointId": "point-a" },
        "tangentAngleDeg": { "kind": "expression", "expression": "@notch-angle" },
        "distance": { "kind": "expression", "expression": "- (@notch-height / 5)" }
      }
    ],
    "evaluationLimitIndex": 9
  }
}
