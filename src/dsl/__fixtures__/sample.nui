nui 3

# P7 golden: comments and canonical multiline calls are intentional.
color pattern-black ("#31322f", name: "基本線", default: true)
color cut-red ("#b42318", name: "裁断線")

role seam (name: "縫い代")
view 通常 (default: true, seam: false)
view 印刷 (default: true, seam: true)
activeView 通常

group 前身頃 {
  point A = coordinate(
    x: 0,
    y: 0
  )
  point B = offset(
    from: @A,
    dx: 0,
    dy: -(840 / 4)
  )
  line AB = segment(
    start: @A,
    end: @B
  )

  if 見返し (true) {
    point C = coordinate(
      x: 10,
      y: 10
    )
  } else {
    point D = coordinate(
      x: 20,
      y: 20
    )
  }

  for 繰返し (i, from: 0, count: 3, step: 1) {
    point P = coordinate(
      x: i * 10,
      y: 0
    )
  }
}

point = coordinate(
  x: 5,
  y: 5
)

@stop

point after = coordinate(
  x: 99,
  y: 99
)

printLayout A4 (
  output: pdf,
  view: 印刷,
  paper: a4,
  orientation: portrait,
  columns: 2,
  rows: 2,
  overlap: 10,
  scale: 1,
  canvas: (410, 584)
) {
  place 前身頃 (at: (0, 15), angle: 0, mirrorX: false)
}
