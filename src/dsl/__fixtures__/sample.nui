nui 1

color pattern-black "#31322f" name="基本線" default
color cut-red "#b42318" name="裁断線"

role seam name="縫い代"
view 通常 default=true seam=false
view 印刷 default=true seam=true
activeView 通常

printLayout A4 output=pdf view=印刷 paper=a4 orientation=portrait columns=2 rows=2 overlap=10 scale=1 canvas=(410, 584) {
  layoutVar margin = 15
  place 前身頃 at=(0, margin) angle=0 mirrorX=false
}

var bust = 840

group 前身頃 {
  point A = (0, 0)
  point B = offset A dx=0 dy=-(bust / 4)
  line AB = A -> B

  if 見返し condition=1 {
    point C = (10, 10)
  } else {
    point D = (20, 20)
  }

  for 繰返し i start=0 count=3 step=1 {
    point P = (i * 10, 0)
  }
}

point = (5, 5)

@stop

point after = (99, 99)
