{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "nuinuiCAD",
  "version": "0.0.0",
  "identifier": "com.yosomi.nuinuicad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nuinuiCAD",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  }
}
